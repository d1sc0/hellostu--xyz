---
import '../styles/like-share.css';

const { currentSlug, title, description } = Astro.props;
---

<div
  class="like-share"
  data-slug={currentSlug}
  data-title={title}
  data-desc={description}
>
  <button
    type="button"
    class="like-share__btn like-share__btn--like"
    id="like-btn"
    aria-label="Like this post"
    aria-pressed="false"
    disabled
  >
    <svg
      class="like-share__icon like-share__icon--heart"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
      ></path>
    </svg>
    <span class="like-share__count" id="like-count">...</span>
  </button>

  <button
    type="button"
    class="like-share__btn like-share__btn--share"
    id="share-btn"
    aria-label="Share this post"
  >
    <svg
      class="like-share__icon like-share__icon--share"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
      <polyline points="16 6 12 2 8 6"></polyline>
      <line x1="12" y1="2" x2="12" y2="15"></line>
    </svg>
    <span class="like-share__label" id="share-label">Share</span>
  </button>
</div>

<script>
  import '../scripts/like-share.js';
</script>
