---
import { SEO } from 'astro-seo';
import fs from 'node:fs';
import crypto from 'node:crypto';
import lexendLatinWoff2 from '@fontsource-variable/lexend/files/lexend-latin-wght-normal.woff2?url';
import gochiHandLatinWoff2 from '@fontsource/gochi-hand/files/gochi-hand-latin-400-normal.woff2?url';
const { frontmatter, pageMeta } = Astro.props;
const siteURL = Astro.site?.toString() || '';

const apexLoaderHash = crypto
  .createHash('sha256')
  .update(fs.readFileSync('public/scripts/apexchart-loader.js'))
  .digest('hex')
  .slice(0, 8);

// Determine the slug/id for the OG image (prefer id, fallback to slug, fallback to url path)
const urlPath = Astro.url?.pathname?.replace(/\/$/, '') || '';
const urlId =
  frontmatter?.id || frontmatter?.slug || urlPath.split('/').pop() || 'index';

const isHomePage = urlId === 'index' || urlPath === '';
const isAboutPage = urlId === 'about' || urlPath === '/about';
const isPost = Boolean(
  frontmatter?.category ||
    urlPath.startsWith('/posts') ||
    Astro.url?.pathname?.includes('/posts/'),
);

let ogImage = `${siteURL}generated_social_images/${urlId}.png`;
let ogImageWidth = 1200;
let ogImageHeight = 630;
let ogImageType = 'image/png';
let twitterCard: 'summary' | 'summary_large_image' = 'summary_large_image';
let twitterImage = ogImage;
let twitterImageWidth = 1200;
let twitterImageHeight = 630;
let twitterImageType = 'image/png';
let thumbnailImage = `${siteURL}default_social_square.png`;

if (isAboutPage) {
  ogImage = `${siteURL}stuart-mackenzie.jpg`;
  ogImageWidth = 750;
  ogImageHeight = 1000;
  ogImageType = 'image/jpeg';
  twitterCard = 'summary';
  twitterImage = `${siteURL}stuart-mackenzie.jpg`;
  twitterImageWidth = 750;
  twitterImageHeight = 1000;
  twitterImageType = 'image/jpeg';
  thumbnailImage = `${siteURL}stuart-mackenzie.jpg`;
} else if (isPost) {
  const ogImagePath = `public/generated_social_images/${urlId}.png`;
  if (!fs.existsSync(ogImagePath)) {
    ogImage = `${siteURL}default_social.png`;
  }
  twitterImage = ogImage;
  thumbnailImage = ogImage;
} else {
  const ogImagePath = `public/generated_social_images/${urlId}.png`;
  if (!fs.existsSync(ogImagePath)) {
    ogImage = `${siteURL}default_social.png`;
  }
  twitterImage = ogImage;
  thumbnailImage = isHomePage ? `${siteURL}stuart-mackenzie.jpg` : ogImage;
}

const rawTitle = frontmatter?.title || pageMeta?.title || '';
let title = 'HelloStu';
if (rawTitle) {
  title = `${rawTitle} | HelloStu`;
} else if (urlId === 'index' || urlPath === '') {
  title = 'Stuart Mackenzie | HelloStu';
}

const description = frontmatter?.description || pageMeta?.description || '';
const socialImageAlt = `${title} social preview image`;

// Canonical Person Entity for Google Knowledge Graph
const personEntity = {
  '@type': 'Person',
  '@id': `${siteURL.replace(/\/$/, '')}/#person`,
  name: 'Stuart Mackenzie',
  alternateName: ['HelloStu', 'disco-stu', 'd1sc0'],
  url: siteURL.replace(/\/$/, '') || 'https://hellostu.xyz',
  image: `${siteURL}stuart-mackenzie.jpg`,
  jobTitle: 'Senior Partner',
  worksFor: {
    '@type': 'Organization',
    name: 'TPXimpact',
    url: 'https://tpximpact.com',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Dorchester',
    addressRegion: 'Dorset',
    addressCountry: 'UK',
  },
  sameAs: [
    'https://uk.linkedin.com/in/stuartjmackenzie/',
    'https://github.com/d1sc0/',
    'https://www.instagram.com/_d1sco/',
    'https://www.threads.net/@_d1sco',
    'https://bsky.app/profile/hellostu.xyz',
    'https://www.strava.com/athletes/1170885/',
    'https://www.parkrun.org.uk/thegreatfield/',
  ],
};

let jsonLd: Record<string, any>;

if (isPost) {
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: frontmatter?.title || title,
    description: description,
    image: ogImage,
    datePublished: frontmatter?.pubDate,
    author: personEntity,
    publisher: personEntity,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': siteURL.replace(/\/$/, '') + (Astro.url?.pathname || '/'),
    },
  };
} else if (isHomePage || isAboutPage) {
  jsonLd = {
    '@context': 'https://schema.org',
    '@graph': [
      personEntity,
      {
        '@type': isHomePage ? 'WebSite' : 'ProfilePage',
        '@id': siteURL.replace(/\/$/, '') + (Astro.url?.pathname || '/'),
        url: siteURL.replace(/\/$/, '') + (Astro.url?.pathname || '/'),
        name: title,
        description: description,
        ...(isAboutPage
          ? {
              image: `${siteURL}stuart-mackenzie.jpg`,
              primaryImageOfPage: {
                '@type': 'ImageObject',
                url: `${siteURL}stuart-mackenzie.jpg`,
                caption: 'Stuart Mackenzie',
              },
            }
          : {}),
        about: { '@id': `${siteURL.replace(/\/$/, '')}/#person` },
        mainEntity: { '@id': `${siteURL.replace(/\/$/, '')}/#person` },
      },
    ],
  };
} else {
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    headline: title,
    description: description,
    image: ogImage,
    author: personEntity,
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': siteURL.replace(/\/$/, '') + (Astro.url?.pathname || '/'),
    },
  };
}
---

<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link
    rel="canonical"
    href={siteURL.replace(/\/$/, '') + (Astro.url?.pathname || '/')}
  />
  <link
    rel="alternate"
    type="application/rss+xml"
    title="HelloStu"
    href="/rss-feed.xml"
  />
  <link
    rel="webmention"
    href="https://webmention.io/hellostu.xyz/webmention"
  />
  <link
    rel="pingback"
    href="https://webmention.io/hellostu.xyz/xmlrpc"
  />
  <script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jsonLd)}
  />
  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
  <link
    rel="preload"
    href={lexendLatinWoff2}
    as="font"
    type="font/woff2"
    crossorigin="anonymous"
  />
  <link
    rel="preload"
    href={gochiHandLatinWoff2}
    as="font"
    type="font/woff2"
    crossorigin="anonymous"
  />
  <SEO
    title={title}
    description={description}
    openGraph={{
      basic: {
        title: title,
        type: isPost ? 'article' : 'website',
        image: ogImage,
      },
      optional: {
        description: description,
      },
      ...(isPost ? { article: { authors: ['Stuart Mackenzie'] } } : {}),
    }}
    twitter={{
      creator: '@_disco',
      card: twitterCard,
      title: title,
      image: twitterImage,
      description: description,
    }}
  />
  <meta name="thumbnail" content={thumbnailImage} />
  <meta property="og:image:width" content={String(ogImageWidth)} />
  <meta property="og:image:height" content={String(ogImageHeight)} />
  <meta property="og:image:type" content={ogImageType} />
  <meta property="og:image:alt" content={socialImageAlt} />
  <meta name="twitter:image:width" content={String(twitterImageWidth)} />
  <meta name="twitter:image:height" content={String(twitterImageHeight)} />
  <meta name="twitter:image:type" content={twitterImageType} />
  <meta name="twitter:image:alt" content={socialImageAlt} />
  <script
    defer
    src="https://cloud.umami.is/script.js"
    data-website-id="654a48c1-5908-4f15-9c11-61de28477192"></script>
  <script
    defer
    src={`/scripts/apexchart-loader.js?v=${apexLoaderHash}`}
    is:inline></script>
</head>
