---
// Usage:
// import InstagramEmbed from '../../components/for_posts/InstagramEmbed/InstagramEmbed.astro';
//
// <InstagramEmbed url="https://www.instagram.com/p/C8o79e7v7aO/" />
// <InstagramEmbed url="C8o79e7v7aO" captioned={false} />
// <InstagramEmbed url="C8o79e7v7aO" maxWidth="100%" />
// <InstagramEmbed url="C8o79e7v7aO" useIframe={true} height="480" />
//

interface Props {
  url: string; // Accepts full URL (p/reel/tv) or just the shortcode
  captioned?: boolean; // Whether to show the caption (default: true)
  maxWidth?: string; // Max width of the embed container (default: '540px')
  useIframe?: boolean; // If true, renders an iframe instead of the script-hydrated blockquote
  height?: string; // Height in pixels for the iframe mode (default: '480')
}

const {
  url,
  captioned = true,
  maxWidth = '540px',
  useIframe = false,
  height = '480',
} = Astro.props;

// Parse the shortcode and type
const getShortcodeAndType = (input: string) => {
  if (!input) return { id: '', type: 'p' };
  
  // Clean query params
  const cleanInput = input.split('?')[0].trim();
  
  // Try to match URL structure
  // e.g. https://www.instagram.com/p/C-x1y2z3w/ or /reel/C-x1y2z3w/ or /tv/C-x1y2z3w/
  const match = cleanInput.match(/instagram\.com\/(p|reel|tv)\/([A-Za-z0-9_-]+)/i);
  if (match) {
    return { type: match[1].toLowerCase(), id: match[2] };
  }
  
  // Default to type 'p' (post) if it's just the shortcode
  return { type: 'p', id: cleanInput };
};

const { id, type } = getShortcodeAndType(url);
const permalink = `https://www.instagram.com/${type}/${id}/`;
const embedSrc = `${permalink}embed${captioned ? '/captioned' : ''}`;
---

{id ? (
  <div class="instagram-embed-wrapper">
    {useIframe ? (
      <iframe
        src={embedSrc}
        class="instagram-embed-iframe"
        allowtransparency="true"
        allowfullscreen="true"
        frameborder="0"
        scrolling="no"
        style={`border: 1px solid var(--border-color, #dbdbdb); border-radius: 12px; width: 100%; max-width: ${maxWidth}; height: ${height}px; display: block; margin: 0 auto;`}
      ></iframe>
    ) : (
      <blockquote
        class="instagram-media"
        data-instgrm-captioned={captioned ? "" : undefined}
        data-instgrm-permalink={permalink}
        data-instgrm-version="14"
        style={`background:#FFF; border:0; border-radius:12px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin: 0 auto; max-width:${maxWidth}; min-width:326px; padding:0; width:calc(100% - 2px); display: block;`}
      >
        <div style="padding:16px;">
          <a
            href={permalink}
            target="_blank"
            rel="noopener noreferrer"
            style="color:#000; font-family:sans-serif; font-size:14px; font-style:normal; font-weight:normal; line-height:17px; text-decoration:none;"
          >
            View this post on Instagram
          </a>
        </div>
      </blockquote>
      <script is:inline async src="//www.instagram.com/embed.js"></script>
    )}
  </div>
) : (
  <div class="instagram-embed-error">
    <p>Error: Invalid Instagram URL or ID provided.</p>
  </div>
)}

<style>
  .instagram-embed-wrapper {
    margin: 2rem auto;
    width: 100%;
    display: flex;
    justify-content: center;
  }
  
  .instagram-embed-error {
    margin: 2rem auto;
    padding: 1rem;
    border: 1px dashed var(--error-color, #ff0000);
    border-radius: 8px;
    text-align: center;
    color: var(--error-color, #ff0000);
  }
</style>
