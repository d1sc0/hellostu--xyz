---
import fs from 'node:fs';
import path from 'node:path';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import YAML from 'yaml';
import exifr from 'exifr';
import '../styles/photos.css';

interface Props {
  manifest?: string;
  showFilters?: boolean;
  enableDeepLinking?: boolean;
}

const {
  manifest = 'src/content/photos.yaml',
  showFilters = true,
  enableDeepLinking = true,
} = Astro.props;

interface PhotoItem {
  src: string;
  title?: string;
  alt?: string;
  caption?: string;
  camera?: string;
  category?: string;
  date?: string;
  slug?: string;
}

interface PhotosManifest {
  title?: string;
  description?: string;
  intro?: string;
  photos?: PhotoItem[];
}

interface ResolvedPhoto {
  index: number;
  slug: string;
  metadata: ImageMetadata;
  title: string;
  alt: string;
  caption: string;
  camera: string;
  category: string;
  date: string;
}

// 1. Eagerly load all assets
const imageModules = import.meta.glob(
  '/src/assets/images/**/*.{avif,gif,jpeg,jpg,png,webp}',
  { eager: true, import: 'default' },
) as Record<string, ImageMetadata>;

const imageByRelativePath = new Map<string, ImageMetadata>();
const imageByBaseName = new Map<string, ImageMetadata>();

for (const [assetPath, metadata] of Object.entries(imageModules)) {
  const relativePath = assetPath.replace('/src/assets/images/', '');
  imageByRelativePath.set(relativePath, metadata);
  const baseName = path.basename(relativePath);
  if (!imageByBaseName.has(baseName)) {
    imageByBaseName.set(baseName, metadata);
  }
}

// 2. Read photos manifest
const photosYamlPath = path.isAbsolute(manifest)
  ? manifest
  : path.join(process.cwd(), manifest);

let photosData: PhotosManifest = {
  photos: [],
};

if (fs.existsSync(photosYamlPath)) {
  try {
    const rawYaml = fs.readFileSync(photosYamlPath, 'utf8');
    const parsed = YAML.parse(rawYaml);
    if (parsed) photosData = parsed;
  } catch (e) {
    console.error('Error parsing photos manifest:', e);
  }
}

function resolveImage(src: string): ImageMetadata | null {
  const clean = src.split('?')[0].split('#')[0].replace(/\\/g, '/');
  const marker = 'assets/images/';
  const markerIndex = clean.indexOf(marker);
  const rel = markerIndex >= 0 ? clean.slice(markerIndex + marker.length) : path.basename(clean);

  return (
    imageByRelativePath.get(rel) ||
    imageByBaseName.get(path.basename(clean)) ||
    null
  );
}

function resolveDiskPath(src: string): string | null {
  const clean = src.split('?')[0].split('#')[0].replace(/\\/g, '/');
  const marker = 'assets/images/';
  const markerIndex = clean.indexOf(marker);
  const rel = markerIndex >= 0 ? clean.slice(markerIndex + marker.length) : path.basename(clean);
  const candidate = path.join(process.cwd(), 'src/assets/images', rel);
  if (fs.existsSync(candidate)) return candidate;
  
  const base = path.basename(clean);
  const portfolioCandidate = path.join(process.cwd(), 'src/assets/images/portfolio', base);
  if (fs.existsSync(portfolioCandidate)) return portfolioCandidate;
  
  return null;
}

function cleanCamera(make?: string, model?: string) {
  if (!model) return '';
  let str = model;
  if (make && /apple/i.test(make)) {
    return model.replace(/^Apple\s+/i, '');
  }
  if (make && /google/i.test(make)) {
    return model;
  }
  if (make && /nikon/i.test(make)) {
    str = model.replace(/^NIKON CORPORATION\s*/i, '').replace(/^NIKON\s+/i, 'Nikon ');
    if (!str.startsWith('Nikon')) str = `Nikon ${str}`;
  }
  if (make && /olympus/i.test(make)) {
    str = model
      .replace(/^OLYMPUS CORPORATION\s*/i, '')
      .replace(/E-M1MarkIII/i, 'Olympus E-M1 Mark III')
      .replace(/E-M1MarkII/i, 'Olympus E-M1 Mark II')
      .replace(/E-M5MarkII/i, 'Olympus E-M5 Mark II')
      .replace(/E-M10MarkII/i, 'Olympus E-M10 Mark II');
    if (!str.startsWith('Olympus')) str = `Olympus ${str}`;
  }
  return str.trim();
}

function cleanLens(lens?: string) {
  if (!lens) return '';
  if (/iphone|pixel|galaxy|huawei|camera/i.test(lens)) return '';
  return lens
    .replace(/^Olympus M\.Zuiko Digital ED /i, '')
    .replace(/^OLYMPUS M\./i, '')
    .replace(/^NIKON /i, '')
    .trim();
}

function generateSlug(title: string, src: string, usedSlugs: Set<string>): string {
  let base = '';
  if (title) {
    base = title.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  }
  if (!base) {
    const rawName = path.basename(src).replace(/\.[^.]+$/, '');
    base = rawName.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
  }
  if (!base) base = 'photo';

  let slug = base;
  let counter = 1;
  while (usedSlugs.has(slug)) {
    counter++;
    slug = `${base}-${counter}`;
  }
  usedSlugs.add(slug);
  return slug;
}

const usedSlugs = new Set<string>();

const rawResolved = await Promise.all(
  (photosData.photos || []).map(async (p, idx) => {
    const meta = resolveImage(p.src);
    if (!meta) return null;

    let date = p.date || '';
    let camera = p.camera || '';

    // If date or camera are missing, extract dynamically from EXIF at build time
    if (!date || !camera) {
      const diskPath = resolveDiskPath(p.src);
      if (diskPath) {
        try {
          const exif = await exifr.parse(diskPath, { tiff: true, exif: true });
          if (!date) {
            const rawDate = exif?.DateTimeOriginal || exif?.CreateDate || exif?.ModifyDate;
            if (rawDate) {
              date = new Date(rawDate).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
            }
          }
          if (!camera) {
            const cam = cleanCamera(exif?.Make, exif?.Model);
            const lens = cleanLens(exif?.LensModel);
            camera = [cam, lens].filter(Boolean).join(' • ');
          }
        } catch {
          // Gracefully ignore EXIF errors if metadata is missing/unreadable
        }
      }
    }

    const slug = p.slug || generateSlug(p.title || '', p.src, usedSlugs);

    return {
      index: idx,
      slug,
      metadata: meta,
      title: p.title || '',
      alt: p.alt || p.title || 'Portfolio photograph',
      caption: p.caption || '',
      camera: camera || '',
      category: p.category || 'Other',
      date: date || '',
    };
  })
);

const resolvedPhotos: ResolvedPhoto[] = rawResolved.filter((p): p is ResolvedPhoto => p !== null);

const PREFERRED_ORDER = ['Self', 'People', 'Animals', 'Places', 'Other'];
const activeCategories = new Set(resolvedPhotos.map((p) => p.category).filter(Boolean));
const orderedCategories = PREFERRED_ORDER.filter((cat) => activeCategories.has(cat));
const otherActive = Array.from(activeCategories).filter((c) => !PREFERRED_ORDER.includes(c));

const categories = ['All', ...orderedCategories, ...otherActive];
---

<div class="photo-gallery-wrapper" data-deep-linking={enableDeepLinking ? 'true' : 'false'}>
  {showFilters && categories.length > 2 && (
    <nav class="photos-filters" aria-label="Filter photos by category">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`filter-btn ${idx === 0 ? 'active' : ''}`}
          data-filter={cat === 'All' ? '*' : cat}
        >
          {cat}
        </button>
      ))}
    </nav>
  )}

  <!-- Pure Masonry Grid (Images Only) -->
  <div class="photos-masonry" id="photos-grid">
    {resolvedPhotos.map((photo) => (
      <button
        type="button"
        class="photo-item"
        id={`photo-${photo.slug}`}
        data-category={photo.category}
        data-index={photo.index}
        data-slug={photo.slug}
        data-title={photo.title}
        data-caption={photo.caption}
        data-camera={photo.camera}
        data-date={photo.date}
        data-src={photo.metadata.src}
        data-alt={photo.alt}
        aria-label={`View ${photo.title || photo.alt} full size`}
      >
        <Image
          src={photo.metadata}
          alt={photo.alt}
          widths={[400, 750, 1100, 1600]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="photo-item__img"
          loading={photo.index < 4 ? 'eager' : 'lazy'}
        />
      </button>
    ))}
  </div>

  <!-- Fullscreen Lightbox Modal with Text Overlay & Direct Permalinks -->
  <dialog class="lightbox" id="photo-lightbox" aria-label="Photo Lightbox">
    <div class="lightbox__top">
      <span class="lightbox__counter" id="lightbox-counter">1 / 1</span>
      
      <div class="lightbox__actions">
        <span class="lightbox__share-feedback" id="lightbox-share-feedback">Link Copied!</span>
        <button
          type="button"
          class="lightbox__btn-top"
          id="lightbox-share"
          aria-label="Copy direct link to this photograph"
          title="Copy direct link"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
            <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
          </svg>
        </button>
        <button type="button" class="lightbox__close" id="lightbox-close" aria-label="Close photo viewer">
          ✕
        </button>
      </div>
    </div>

    <div class="lightbox__stage">
      <button
        type="button"
        class="lightbox__btn lightbox__btn--prev"
        id="lightbox-prev"
        aria-label="Previous photograph"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <img src="" alt="" class="lightbox__img" id="lightbox-img" />

      <button
        type="button"
        class="lightbox__btn lightbox__btn--next"
        id="lightbox-next"
        aria-label="Next photograph"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <!-- Overlay for Titles & EXIF Metadata -->
      <div class="lightbox__overlay" id="lightbox-overlay">
        <h2 class="lightbox__title" id="lightbox-title"></h2>
        <p class="lightbox__caption" id="lightbox-caption"></p>
        <p class="lightbox__camera" id="lightbox-camera"></p>
        <p class="lightbox__date" id="lightbox-date"></p>
      </div>
    </div>
  </dialog>
</div>

<script>
  function setupGallery() {
    const wrapper = document.querySelector('.photo-gallery-wrapper');
    const grid = document.getElementById('photos-grid');
    const filterBtns = document.querySelectorAll('.filter-btn');
    const photoItems = Array.from(document.querySelectorAll<HTMLElement>('.photo-item'));
    const lightbox = document.getElementById('photo-lightbox') as HTMLDialogElement | null;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxOverlay = document.getElementById('lightbox-overlay');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxCamera = document.getElementById('lightbox-camera');
    const lightboxDate = document.getElementById('lightbox-date');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxShare = document.getElementById('lightbox-share');
    const lightboxFeedback = document.getElementById('lightbox-share-feedback');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');

    if (!grid || !lightbox || !lightboxImg) return;

    const deepLinkingEnabled = wrapper?.getAttribute('data-deep-linking') === 'true';

    let currentVisibleItems = [...photoItems];
    let currentIndex = 0;

    function updateUrlHash(slug: string) {
      if (!deepLinkingEnabled || !slug) return;
      history.replaceState(null, '', `#${slug}`);
    }

    function clearUrlHash() {
      if (!deepLinkingEnabled) return;
      if (window.location.hash) {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      }
    }

    // Filter functionality
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter') || '*';

        currentVisibleItems = [];
        photoItems.forEach((item) => {
          const category = item.getAttribute('data-category');
          if (filter === '*' || category === filter) {
            item.classList.remove('hidden');
            currentVisibleItems.push(item);
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });

    // Lightbox open & render
    function openLightbox(indexInVisible: number) {
      if (indexInVisible < 0 || indexInVisible >= currentVisibleItems.length) return;
      currentIndex = indexInVisible;
      const item = currentVisibleItems[currentIndex];

      const fullSrc = item.getAttribute('data-src') || '';
      const title = item.getAttribute('data-title') || '';
      const caption = item.getAttribute('data-caption') || '';
      const camera = item.getAttribute('data-camera') || '';
      const date = item.getAttribute('data-date') || '';
      const alt = item.getAttribute('data-alt') || '';
      const category = item.getAttribute('data-category') || '';
      const slug = item.getAttribute('data-slug') || '';

      lightboxImg!.src = fullSrc;
      lightboxImg!.alt = alt;

      if (lightboxTitle) {
        lightboxTitle.textContent = title;
        lightboxTitle.style.display = title ? 'block' : 'none';
      }

      if (lightboxCaption) {
        lightboxCaption.textContent = caption;
        lightboxCaption.style.display = caption ? 'block' : 'none';
      }

      if (lightboxCamera) {
        lightboxCamera.textContent = camera;
        lightboxCamera.style.display = camera ? 'block' : 'none';
      }

      if (lightboxDate) {
        lightboxDate.textContent = date;
        lightboxDate.style.display = date ? 'block' : 'none';
      }

      if (lightboxOverlay) {
        const hasText = Boolean(title || caption || camera || date);
        lightboxOverlay.style.display = hasText ? 'flex' : 'none';
      }

      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentIndex + 1} / ${currentVisibleItems.length}`;
      }

      if (!lightbox!.open) {
        lightbox!.showModal();
      }
      document.body.style.overflow = 'hidden';
      lightbox!.classList.add('active');

      updateUrlHash(slug);
    }

    function closeLightbox() {
      lightbox!.classList.remove('active');
      clearUrlHash();
      setTimeout(() => {
        if (lightbox!.open) lightbox!.close();
        document.body.style.overflow = '';
      }, 200);
    }

    function showPrev() {
      if (currentVisibleItems.length <= 1) return;
      const prev = (currentIndex - 1 + currentVisibleItems.length) % currentVisibleItems.length;
      openLightbox(prev);
    }

    function showNext() {
      if (currentVisibleItems.length <= 1) return;
      const next = (currentIndex + 1) % currentVisibleItems.length;
      openLightbox(next);
    }

    // Click events on thumbnails
    photoItems.forEach((item) => {
      item.addEventListener('click', () => {
        const visibleIdx = currentVisibleItems.indexOf(item);
        if (visibleIdx >= 0) {
          openLightbox(visibleIdx);
        }
      });
    });

    // Copy direct link action
    lightboxShare?.addEventListener('click', async (e) => {
      e.stopPropagation();
      const currentItem = currentVisibleItems[currentIndex];
      const slug = currentItem?.getAttribute('data-slug') || '';
      const url = `${window.location.origin}${window.location.pathname}#${slug}`;

      try {
        if (navigator.clipboard) {
          await navigator.clipboard.writeText(url);
        }
        if (lightboxFeedback) {
          lightboxFeedback.classList.add('visible');
          setTimeout(() => {
            lightboxFeedback.classList.remove('visible');
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy photo permalink:', err);
      }
    });

    // Button event listeners
    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxPrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      showPrev();
    });
    lightboxNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      showNext();
    });

    // Backdrop click to close
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || (e.target as HTMLElement).classList.contains('lightbox__stage')) {
        closeLightbox();
      }
    });

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      if (!lightbox.open) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
    });

    // Touch swipe navigation for mobile
    let touchStartX = 0;
    let touchEndX = 0;

    lightbox.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true },
    );

    lightbox.addEventListener(
      'touchend',
      (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 40) {
          if (diff < 0) showNext();
          else showPrev();
        }
      },
      { passive: true },
    );

    // Check URL Hash for deep linking on load or hash change
    function handleHashChange() {
      if (!deepLinkingEnabled) return;
      const rawHash = window.location.hash.replace(/^#/, '').toLowerCase();
      if (!rawHash) return;

      const targetItem = photoItems.find((item) => {
        const slug = item.getAttribute('data-slug')?.toLowerCase();
        return slug === rawHash || item.id === `photo-${rawHash}` || item.id === rawHash;
      });

      if (targetItem) {
        const category = targetItem.getAttribute('data-category');
        const activeFilterBtn = document.querySelector('.filter-btn.active');
        const currentFilter = activeFilterBtn?.getAttribute('data-filter') || '*';

        if (currentFilter !== '*' && currentFilter !== category) {
          const allBtn = document.querySelector('.filter-btn[data-filter="*"]') as HTMLButtonElement;
          allBtn?.click();
        }

        const visibleIdx = currentVisibleItems.indexOf(targetItem);
        if (visibleIdx >= 0) {
          openLightbox(visibleIdx);
        }
      }
    }

    // Trigger on load
    handleHashChange();
    window.addEventListener('hashchange', handleHashChange);
  }

  // Support Astro ViewTransitions and standard page loads
  document.addEventListener('DOMContentLoaded', setupGallery);
  document.addEventListener('astro:page-load', setupGallery);
</script>
