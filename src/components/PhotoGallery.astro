---
import fs from 'node:fs';
import path from 'node:path';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import YAML from 'yaml';
import '../styles/photos.css';

interface Props {
  manifest?: string;
  showFilters?: boolean;
}

const {
  manifest = 'src/content/photos.yaml',
  showFilters = true,
} = Astro.props;

interface PhotoItem {
  src: string;
  title?: string;
  alt?: string;
  caption?: string;
  category?: string;
  date?: string;
}

interface PhotosManifest {
  title?: string;
  description?: string;
  intro?: string;
  photos?: PhotoItem[];
}

interface ResolvedPhoto {
  index: number;
  metadata: ImageMetadata;
  title: string;
  alt: string;
  caption: string;
  category: string;
  date: string;
}

// 1. Eagerly load all assets
const imageModules = import.meta.glob(
  '/src/assets/images/**/*.{avif,gif,jpeg,jpg,png,webp}',
  { eager: true, import: 'default' },
) as Record<string, ImageMetadata>;

const imageByRelativePath = new Map<string, ImageMetadata>();
const imageByBaseName = new Map<string, ImageMetadata>();

for (const [assetPath, metadata] of Object.entries(imageModules)) {
  const relativePath = assetPath.replace('/src/assets/images/', '');
  imageByRelativePath.set(relativePath, metadata);
  const baseName = path.basename(relativePath);
  if (!imageByBaseName.has(baseName)) {
    imageByBaseName.set(baseName, metadata);
  }
}

// 2. Read photos manifest
const photosYamlPath = path.isAbsolute(manifest)
  ? manifest
  : path.join(process.cwd(), manifest);

let photosData: PhotosManifest = {
  photos: [],
};

if (fs.existsSync(photosYamlPath)) {
  try {
    const rawYaml = fs.readFileSync(photosYamlPath, 'utf8');
    const parsed = YAML.parse(rawYaml);
    if (parsed) photosData = parsed;
  } catch (e) {
    console.error('Error parsing photos manifest:', e);
  }
}

function resolveImage(src: string): ImageMetadata | null {
  const clean = src.split('?')[0].split('#')[0].replace(/\\/g, '/');
  const marker = 'assets/images/';
  const markerIndex = clean.indexOf(marker);
  const rel = markerIndex >= 0 ? clean.slice(markerIndex + marker.length) : path.basename(clean);

  return (
    imageByRelativePath.get(rel) ||
    imageByBaseName.get(path.basename(clean)) ||
    null
  );
}

const resolvedPhotos: ResolvedPhoto[] = (photosData.photos || [])
  .map((p, idx) => {
    const meta = resolveImage(p.src);
    if (!meta) return null;
    return {
      index: idx,
      metadata: meta,
      title: p.title || '',
      alt: p.alt || p.title || 'Portfolio photograph',
      caption: p.caption || '',
      category: p.category || 'Portfolio',
      date: p.date || '',
    };
  })
  .filter((p): p is ResolvedPhoto => p !== null);

const categories = ['All', ...Array.from(new Set(resolvedPhotos.map((p) => p.category).filter(Boolean)))];
---

<div class="photo-gallery-wrapper">
  {showFilters && categories.length > 2 && (
    <nav class="photos-filters" aria-label="Filter photos by category">
      {categories.map((cat, idx) => (
        <button
          type="button"
          class={`filter-btn ${idx === 0 ? 'active' : ''}`}
          data-filter={cat === 'All' ? '*' : cat}
        >
          {cat}
        </button>
      ))}
    </nav>
  )}

  <!-- Pure Masonry Grid (Images Only) -->
  <div class="photos-masonry" id="photos-grid">
    {resolvedPhotos.map((photo) => (
      <button
        type="button"
        class="photo-item"
        data-category={photo.category}
        data-index={photo.index}
        data-title={photo.title}
        data-caption={photo.caption}
        data-date={photo.date}
        data-src={photo.metadata.src}
        data-alt={photo.alt}
        aria-label={`View ${photo.title || photo.alt} full size`}
      >
        <Image
          src={photo.metadata}
          alt={photo.alt}
          widths={[400, 750, 1100, 1600]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="photo-item__img"
          loading={photo.index < 4 ? 'eager' : 'lazy'}
        />
      </button>
    ))}
  </div>

  <!-- Fullscreen Lightbox Modal with Text Overlay -->
  <dialog class="lightbox" id="photo-lightbox" aria-label="Photo Lightbox">
    <div class="lightbox__top">
      <span class="lightbox__counter" id="lightbox-counter">1 / 1</span>
      <button type="button" class="lightbox__close" id="lightbox-close" aria-label="Close photo viewer">
        ✕
      </button>
    </div>

    <div class="lightbox__stage">
      <button
        type="button"
        class="lightbox__btn lightbox__btn--prev"
        id="lightbox-prev"
        aria-label="Previous photograph"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <img src="" alt="" class="lightbox__img" id="lightbox-img" />

      <button
        type="button"
        class="lightbox__btn lightbox__btn--next"
        id="lightbox-next"
        aria-label="Next photograph"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <!-- Overlay for Titles & Metadata -->
      <div class="lightbox__overlay" id="lightbox-overlay">
        <h2 class="lightbox__title" id="lightbox-title"></h2>
        <p class="lightbox__caption" id="lightbox-caption"></p>
      </div>
    </div>
  </dialog>
</div>

<script>
  function setupGallery() {
    const grid = document.getElementById('photos-grid');
    const filterBtns = document.querySelectorAll('.filter-btn');
    const photoItems = Array.from(document.querySelectorAll<HTMLElement>('.photo-item'));
    const lightbox = document.getElementById('photo-lightbox') as HTMLDialogElement | null;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxOverlay = document.getElementById('lightbox-overlay');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const lightboxClose = document.getElementById('lightbox-close');
    const lightboxPrev = document.getElementById('lightbox-prev');
    const lightboxNext = document.getElementById('lightbox-next');

    if (!grid || !lightbox || !lightboxImg) return;

    let currentVisibleItems = [...photoItems];
    let currentIndex = 0;

    // Filter functionality
    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter') || '*';

        currentVisibleItems = [];
        photoItems.forEach((item) => {
          const category = item.getAttribute('data-category');
          if (filter === '*' || category === filter) {
            item.classList.remove('hidden');
            currentVisibleItems.push(item);
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });

    // Lightbox open & render
    function openLightbox(indexInVisible: number) {
      if (indexInVisible < 0 || indexInVisible >= currentVisibleItems.length) return;
      currentIndex = indexInVisible;
      const item = currentVisibleItems[currentIndex];

      const fullSrc = item.getAttribute('data-src') || '';
      const title = item.getAttribute('data-title') || '';
      const caption = item.getAttribute('data-caption') || '';
      const alt = item.getAttribute('data-alt') || '';
      const category = item.getAttribute('data-category') || '';
      const date = item.getAttribute('data-date') || '';

      lightboxImg!.src = fullSrc;
      lightboxImg!.alt = alt;

      if (lightboxTitle) {
        lightboxTitle.textContent = title;
        lightboxTitle.style.display = title ? 'block' : 'none';
      }

      if (lightboxCaption) {
        const metaParts = [caption, category, date].filter(Boolean);
        lightboxCaption.textContent = metaParts.join(' • ');
        lightboxCaption.style.display = metaParts.length > 0 ? 'block' : 'none';
      }

      if (lightboxOverlay) {
        const hasText = Boolean(title || caption || category || date);
        lightboxOverlay.style.display = hasText ? 'flex' : 'none';
      }

      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentIndex + 1} / ${currentVisibleItems.length}`;
      }

      if (!lightbox!.open) {
        lightbox!.showModal();
      }
      document.body.style.overflow = 'hidden';
      lightbox!.classList.add('active');
    }

    function closeLightbox() {
      lightbox!.classList.remove('active');
      setTimeout(() => {
        if (lightbox!.open) lightbox!.close();
        document.body.style.overflow = '';
      }, 200);
    }

    function showPrev() {
      if (currentVisibleItems.length <= 1) return;
      const prev = (currentIndex - 1 + currentVisibleItems.length) % currentVisibleItems.length;
      openLightbox(prev);
    }

    function showNext() {
      if (currentVisibleItems.length <= 1) return;
      const next = (currentIndex + 1) % currentVisibleItems.length;
      openLightbox(next);
    }

    // Click events
    photoItems.forEach((item) => {
      item.addEventListener('click', () => {
        const visibleIdx = currentVisibleItems.indexOf(item);
        if (visibleIdx >= 0) {
          openLightbox(visibleIdx);
        }
      });
    });

    // Button event listeners
    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxPrev?.addEventListener('click', (e) => {
      e.stopPropagation();
      showPrev();
    });
    lightboxNext?.addEventListener('click', (e) => {
      e.stopPropagation();
      showNext();
    });

    // Backdrop click to close
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox || (e.target as HTMLElement).classList.contains('lightbox__stage')) {
        closeLightbox();
      }
    });

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      if (!lightbox.open) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'ArrowRight') showNext();
    });

    // Touch swipe navigation for mobile
    let touchStartX = 0;
    let touchEndX = 0;

    lightbox.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true },
    );

    lightbox.addEventListener(
      'touchend',
      (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchEndX - touchStartX;
        if (Math.abs(diff) > 40) {
          if (diff < 0) showNext();
          else showPrev();
        }
      },
      { passive: true },
    );
  }

  // Support Astro ViewTransitions and standard page loads
  document.addEventListener('DOMContentLoaded', setupGallery);
  document.addEventListener('astro:page-load', setupGallery);
</script>
