{
  "name": "hellostu--xyz",
  "type": "module",
  "version": "2.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run prebuild && npm run sync:raindrop && npm run generate:recommendations && astro dev",
    "start": "astro dev",
    "prebuild": "node src/scripts/pre-build-sveltia-cms-catches.js && ts-node src/scripts/image-generation/generate-og-images.ts",
    "prebuild:clean": "node src/scripts/pre-build-sveltia-cms-catches.js --clean && ts-node src/scripts/image-generation/generate-og-images.ts",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate:og": "ts-node src/scripts/image-generation/generate-og-images.ts",
    "generate:preview": "ts-node src/scripts/image-generation/generate-preview-images.ts",
    "generate:recommendations": "node src/scripts/recommendations.mjs",
    "generate:recommendations:force": "node src/scripts/recommendations.mjs --force",
    "generate:recommendations:test": "node src/scripts/recommendations.mjs --test",
    "sync:raindrop": "node src/scripts/raindrop.mjs",
    "raindrop:list": "node src/scripts/raindrop.mjs --list",
    "raindrop:collections": "node src/scripts/raindrop.mjs --collections"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@google/genai": "^2.30.0",
    "@sveltia/cms": "0.152.5",
    "astro": "^6.4.6",
    "astro-font": "1.1.0",
    "astro-icon": "1.1.5",
    "astro-seo": "1.1.0",
    "exifr": "^7.1.3",
    "firebase": "12.12.0",
    "fs-extra": "^11.3.4",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "puppeteer": "^24.40.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "ts-node": "^10.9.2"
  }
}
